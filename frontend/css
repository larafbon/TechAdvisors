* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --green-dark: #4d8147;
    --green: #73a85f;
    --green-light: #dff0cf;
    --green-soft: #eef8e6;
    --background: #f7fbf2;
    --white: #ffffff;
    --text: #30352f;
    --gray: #737970;
    --border: #d9e8cf;
}

body {
    font-family: "Nunito", sans-serif;
    background: var(--background);
    color: var(--text);
}

/* APP */

.app {
    display: flex;
    min-height: 100vh;
}


/* SIDEBAR */

.sidebar {
    width: 265px;
    min-height: 100vh;
    background: linear-gradient(
        180deg,
        #eaf5df,
        #edf7e8
    );

    padding: 35px 18px;
    border-right: 1px solid #dbe8d3;
    display: flex;
    flex-direction: column;
}


/* LOGO */

.logo-area {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-left: 8px;
}

.logo-icon {
    width: 58px;
    height: 58px;

    background: #d9edc9;

    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 31px;
}

.logo-area h1 {
    color: var(--green-dark);
    font-size: 25px;
    line-height: 0.95;
}

.subtitle {
    margin: 16px 8px 30px;
    color: #598453;
    font-size: 13px;
    line-height: 1.5;
}


/* MENU */

.menu {
    display: flex;
    flex-direction: column;
    gap: 9px;
}

.menu-item {
    display: flex;
    align-items: center;
    gap: 15px;

    padding: 15px;

    border-radius: 22px;

    text-decoration: none;

    color: #303b2d;

    transition: 0.25s;
}

.menu-item span {
    width: 26px;

    font-size: 22px;

    color: #6da461;

    text-align: center;
}

.menu-item p {
    font-size: 15px;
    font-weight: 600;
}

.menu-item:hover {
    background: #e0efcf;
    transform: translateX(3px);
}

.menu-item.active {
    background: #dcefc8;
    color: #355f31;
}


/* SIDEBAR CARD */

.sidebar-card {
    margin-top: auto;

    background: rgba(255, 255, 255, 0.8);

    border: 1px solid #dcebd5;

    border-radius: 22px;

    padding: 25px 12px;

    text-align: center;
}

.sidebar-card p {
    margin-top: 12px;

    font-size: 14px;

    line-height: 1.5;
}

.heart-icons {
    font-size: 25px;
}

.small-icons {
    margin-top: 18px;
    font-size: 20px;
    letter-spacing: 7px;
}


/* MAIN */

.main {
    width: calc(100% - 265px);
    padding: 20px 28px 30px;

    max-width: 1500px;
    margin: auto;
}


/* TOPBAR */

.topbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    gap: 12px;

    margin-bottom: 20px;
}

.calm-button {
    border: 1px solid #dce9d5;
    background: #f0f8e9;

    padding: 11px 18px;

    border-radius: 30px;

    color: #356e34;

    font-size: 15px;
    font-weight: 700;

    cursor: pointer;
}

.icon-button {
    width: 47px;
    height: 47px;

    border-radius: 50%;

    border: 1px solid #cfe0c7;

    background: white;

    font-size: 22px;

    color: var(--green-dark);

    cursor: pointer;
}


/* ASSISTANT */

.assistant-card {

    background: white;

    border: 1px solid #ccdfbf;

    border-radius: 28px;

    min-height: 320px;

    display: flex;

    align-items: center;

    padding: 30px;

    overflow: hidden;

    box-shadow: 0 8px 30px rgba(89, 128, 68, 0.06);

}


.assistant-image {
    width: 42%;
    height: 280px;

    position: relative;

    display: flex;
    align-items: flex-end;
    justify-content: center;
}

.circle-background {
    position: absolute;

    width: 255px;
    height: 255px;

    bottom: 0;

    border-radius: 50%;

    background: #dcefcf;
}

.assistant-emoji {
    position: relative;

    font-size: 145px;

    z-index: 2;

    transform: translateY(3px);
}


/* ASSISTANT TEXT */

.assistant-content {
    flex: 1;

    padding: 10px 30px;
}

.assistant-label {
    display: inline-block;

    background: #e1f1d6;

    color: #41703a;

    padding: 10px 17px;

    border-radius: 25px;

    font-size: 14px;

    margin-bottom: 18px;
}

.assistant-content h2 {
    font-size: 31px;

    margin-bottom: 12px;

    line-height: 1.15;
}

.assistant-content > p {
    font-size: 17px;

    line-height: 1.6;

    max-width: 700px;

    color: #50584d;

    margin-bottom: 20px;
}


/* FEATURES */

.feature-list {
    display: flex;
    gap: 15px;
}

.feature {
    display: flex;
    align-items: center;

    gap: 10px;

    border: 1px solid #e1e9dc;

    border-radius: 20px;

    padding: 12px 17px;

    background: #fbfdf9;

    min-width: 170px;
}

.feature span {
    font-size: 26px;
}

.feature p {
    font-size: 13px;
    line-height: 1.3;
    font-weight: 700;
}


/* QUESTION TITLE */

.question-title {
    margin-top: 20px;

    padding: 18px 25px;

    border-radius: 23px;

    background: white;

    border: 1px solid #ddebd5;

    display: flex;

    gap: 18px;

    align-items: center;
}

.question-icon {
    width: 50px;
    height: 50px;

    border-radius: 50%;

    border: 3px solid #74a967;

    color: #74a967;

    display: flex;
    justify-content: center;
    align-items: center;

    font-size: 27px;
    font-weight: 700;
}

.question-title h3 {
    font-size: 23px;
}

.question-title p {
    color: #697166;
    margin-top: 3px;
}


/* LOUSA */

.chalkboard {

    margin-top: 20px;

    min-height: 350px;

    position: relative;

    background:
        radial-gradient(
            circle at 20% 20%,
            rgba(255,255,255,0.04),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #184d38,
            #174936,
            #14523a
        );

    border: 12px solid #9b6938;

    border-radius: 23px;

    box-shadow:
        0 8px 0 #704724,
        inset 0 0 30px rgba(0,0,0,0.3);

    padding: 45px 70px;

    color: white;

    overflow: hidden;
}


/* CHALK TEXT */

.chalkboard h2 {
    text-align: center;

    font-family: "Comic Sans MS", "Trebuchet MS", cursive;

    font-size: 35px;

    font-weight: 700;

    line-height: 1.2;

    letter-spacing: 1px;

    text-shadow:
        1px 1px 2px rgba(255,255,255,0.15);
}


.chalk-line {

    width: 52%;

    height: 4px;

    margin: 18px auto 28px;

    background: #e487bc;

    border-radius: 50%;
}


/* INPUT */

.chat-input {

    max-width: 820px;

    margin: auto;

    display: flex;

    align-items: center;

    border: 3px solid rgba(255,255,255,0.7);

    border-radius: 30px;

    height: 95px;

    padding-left: 25px;

    background: rgba(0,0,0,0.08);
}

.chat-input input {

    flex: 1;

    height: 100%;

    border: none;

    outline: none;

    background: transparent;

    color: white;

    font-family: "Comic Sans MS", cursive;

    font-size: 21px;
}

.chat-input input::placeholder {
    color: rgba(255,255,255,0.75);
}

.chat-input button {
    width: 80px;

    height: 70px;

    margin-right: 10px;

    background: transparent;

    border: none;

    color: white;

    font-size: 42px;

    cursor: pointer;

    transition: 0.2s;
}

.chat-input button:hover {
    transform: translateX(5px);
}


/* CHALKS */

.chalks {

    display: flex;

    justify-content: center;

    gap: 10px;

    margin-top: 18px;
}

.chalk {
    width: 50px;
    height: 10px;

    border-radius: 10px;

    display: block;
}

.blue {
    background: #4ca1dc;
}

.pink {
    background: #ee82b4;
}

.yellow {
    background: #f2c94c;
}

.white {
    background: #f4eee3;
}

.green {
    background: #a6cf7c;
}


/* DECORAÇÕES */

.chalk-decoration {
    position: absolute;

    font-size: 45px;

    opacity: 0.9;

    font-family: cursive;
}

.bulb {
    left: 40px;
    top: 35px;
}

.heart {
    right: 35px;
    top: 35px;

    color: #ef8db7;
}

.star {
    right: 38px;
    bottom: 55px;

    color: #f5c94d;
}

.puzzle {
    left: 35px;
    bottom: 65px;
}


/* RESPONSE */

.response-area {
    margin-top: 15px;
}

.bot-message {
    display: flex;
    align-items: flex-start;

    gap: 12px;

    background: white;

    border: 1px solid #ddebd5;

    padding: 16px 20px;

    border-radius: 20px;

    max-width: 800px;

    box-shadow: 0 4px 15px rgba(84, 120, 65, 0.04);
}

.bot-avatar {
    width: 45px;
    height: 45px;

    background: #def0d2;

    border-radius: 50%;

    display: flex;
    justify-content: center;
    align-items: center;

    font-size: 22px;
}

.message-content strong {
    color: #4c7947;
}

.message-content p {
    margin-top: 4px;

    color: #596157;

    line-height: 1.5;
}


/* QUICK BUTTONS */

.quick-actions {

    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 15px;

    margin-top: 18px;
}

.quick-button {

    border: 1px solid #dae8d2;

    background: white;

    border-radius: 20px;

    padding: 18px;

    display: flex;

    align-items: center;

    gap: 12px;

    text-align: left;

    cursor: pointer;

    transition: 0.25s;

    color: var(--text);
}

.quick-button:hover {

    transform: translateY(-3px);

    border-color: #a9c996;

    box-shadow: 0 7px 20px rgba(84, 130, 72, 0.08);
}

.quick-button span {
    font-size: 26px;
}

.quick-button p {
    font-size: 14px;
    font-weight: 700;

    line-height: 1.25;
}


/* FOOTER */

footer {

    text-align: center;

    padding: 22px 10px;

    color: #55704e;

    font-size: 14px;
}


/* RESPONSIVIDADE */

@media (max-width: 1100px) {

    .sidebar {
        width: 220px;
    }

    .main {
        width: calc(100% - 220px);
    }

    .assistant-content h2 {
        font-size: 26px;
    }

    .feature-list {
        flex-direction: column;
    }

    .quick-actions {
        grid-template-columns: repeat(2, 1fr);
    }
}


@media (max-width: 800px) {

    .app {
        flex-direction: column;
    }

    .sidebar {
        width: 100%;
        min-height: auto;
        padding: 20px;
    }

    .menu {
        flex-direction: row;
        overflow-x: auto;
    }

    .menu-item {
        flex-shrink: 0;
    }

    .sidebar-card {
        display: none;
    }

    .main {
        width: 100%;
        padding: 15px;
    }

    .assistant-card {
        flex-direction: column;
        text-align: center;
    }

    .assistant-image {
        width: 100%;
        height: 220px;
    }

    .assistant-content {
        padding: 10px;
    }

    .feature-list {
        align-items: center;
    }

    .chalkboard {
        padding: 35px 20px;
    }

    .chalkboard h2 {
        font-size: 25px;
    }
}


@media (max-width: 500px) {

    .quick-actions {
        grid-template-columns: 1fr;
    }

    .topbar {
        justify-content: center;
    }

    .assistant-content h2 {
        font-size: 23px;
    }

    .chat-input {
        height: 75px;
    }

    .chat-input input {
        font-size: 16px;
    }
}
